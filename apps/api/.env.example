# App Settings
APP_NAME=PlateSense
DEBUG=True

# Database
DATABASE_URL=postgresql+asyncpg://platesense:platesense@localhost:5432/platesense

# Auth
SECRET_KEY=generate-a-long-random-secret-key-here
RESET_PASSWORD_TOKEN_SECRET=generate-another-random-secret-here
VERIFICATION_TOKEN_SECRET=generate-third-random-secret-here

# Google OAuth (Optional - required for "Continue with Google")
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# SMTP / Email (Required for "Forgot Password")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=your-email@gmail.com
SMTP_TLS=True

# Frontend
FRONTEND_URL=http://localhost:5173
